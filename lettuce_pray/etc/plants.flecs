    }

    stalk {
        Position3: {-0.05, 1.4, 0}
        Rotation3: {0, 0, 0.35}
        Box: {0.11, 0.34, 0.11}
        Rgba: {74, 148, 60, 255}
    }

    eye_left {
        Position3: {-0.16, 0.78, 0.31}
        Sphere: {segments: 8, smooth: true, radius: 0.075}
        Rgba: eyeDark
    }

    eye_right {
        Position3: {0.16, 0.78, 0.31}
        Sphere: {segments: 8, smooth: true, radius: 0.075}

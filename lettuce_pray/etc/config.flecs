using flecs.engine
using flecs.engine.*
using flecs.script

surface {
    Surface: {
        title: "Lettuce Pray"
        width: 1440
        height: 900
        vsync: true
    }
}

camera {
    Camera: {
        fov: math.PI / 3.4,
        near_: 0.5,
        far_: 400
    }
    Position3: {0, 11.5, 11}
    LookAt: {0, 0, -0.8}
}

sky {
    sun {
        Position3: {-1.4, 2.6, 1.8}
        DirectionalLight: {intensity: 2.2}
        CelestialLight: {
            toa_intensity: 6,
            toa_color: {255, 250, 235, 255}
        }
        LookAt: {0, 0, 0}
        Rgba: {255, 252, 240, 255}
    }

    moon {
        Position3: {1, 2, -1}
        DirectionalLight: {intensity: 0}
        CelestialLight: {
            toa_intensity: 0.0005,
            toa_color: {255, 255, 255, 255}
        }
        LookAt: {0, 0, 0}
        Rgba: {255, 255, 255, 255}
    }

    stars {
        Stars: {
            density: 0.5,
            cells: 180,
            size: 120,
            color_variation: 1
        }
        CelestialLight: {
            toa_intensity: 0.01,
            toa_color: {255, 255, 255, 255}
        }
        Rotation3: {0, 0, 0}
    }

    atmosphere {
        Atmosphere: {
            sun: sun,
            moon: moon,
            stars: stars
        }
    }
}

view {
    geometry { GeometryBatch }
    skybox { SkyBoxBatch }

    ssao {
        SSAO: { radius: 0.4 }
    }

    bloom {
        Bloom: {}
    }

    autoExposure {
        AutoExposure: {
            min_log_luma: -16,
            low_percentile: 0,
            min_brightness: 0.05,
            max_brightness: 0.5
        }
    }

    tonyMcMapFace {
        Tony: { auto_exposure: autoExposure }
    }

    RenderView: {
        camera: camera,
        atmosphere: sky.atmosphere,
        ambient_intensity: 0.6,
        screen_px_threshold: 3,
        shadow: {
            enabled: true,
            map_size: 4096,
            max_range: 120,
            bias: 0.0001
        },
        effects: [
            { enabled: true, effect: ssao },
            { enabled: true, effect: bloom },
            { enabled: true, effect: autoExposure },
            { enabled: true, effect: tonyMcMapFace }
        ]
    }

    RenderBatchSet: {
        batches: [ geometry, skybox ]
    }
}

world {
    const groundY: f32 = -0.25

    ground {
        Position3: {0, -0.75, -14}
        Rgba: {96, 152, 78, 255}
        Box: {300, 1, 220}
    }

    soil {
        Position3: {0, -0.37, 0}
        Rgba: {124, 96, 62, 255}
        Box: {21.2, 0.5, 12.4}
    }

    path {
        Position3: {15.5, -0.62, 0}
        Rgba: {176, 152, 112, 255}
        Box: {12, 0.8, 12.4}
    }

    house {
        Position3: {-16.5, 0, 0}

        base {
            Position3: {0, 2.4, 0}
            Box: {9, 4.8, 12}
            Rgba: {226, 210, 178, 255}
        }

        roof {
            Position3: {0, 5.6, 0}
            Rotation3: {0, 0, 0}
            Scale3: {9.6, 2.4, 13}
            TrianglePrism: {1, 1, 1}
            Rgba: {150, 78, 62, 255}
        }

        for i in 0..3 {
            "window_{i}" {
                Position3: {4.55, 3.1, -4 + i * 4}
                Box: {0.2, 1.5, 1.5}
                Rgba: {120, 190, 220, 255}
                Emissive: {strength: 0.25, color: {160, 210, 240, 255}}
            }
        }

        door {
            Position3: {4.55, 1.2, 0}
            Box: {0.25, 2.4, 1.6}
            Rgba: {120, 82, 58, 255}
        }
    }

    fence {
        for i in 0..17 {
            "post_{i}" {
                Position3: {-14 + i * 2.1, groundY + 0.7, -7.4}
                Box: {0.22, 1.4, 0.22}
                Rgba: {186, 166, 132, 255}
            }
        }

        rail_top {
            Position3: {2, groundY + 1.1, -7.4}
            Box: {34, 0.16, 0.14}
            Rgba: {196, 176, 142, 255}
        }

        rail_bottom {
            Position3: {2, groundY + 0.5, -7.4}
            Box: {34, 0.16, 0.14}
            Rgba: {196, 176, 142, 255}
        }
    }

    const rng: math.Rng = {}

    hedge {
        for i in 0..9 {
            const s = 1.3 + rng.f(0.7)

            "bush_{i}" {
                Position3: {-16 + i * 4.4 + rng.f(1.5), groundY, -9.5 - rng.f(1.5)}
                Scale3: {s, s * 0.8, s}
                HemiSphere: {segments: 14, smooth: true, radius: 1}
                Rgba: {62, 118, 58, 255}
            }
        }
    }

    trees {
        for i in 0..4 {
            const s = 0.9 + rng.f(0.5)

            "tree_{i}" {
                Position3: {-18 + i * 12 + rng.f(4), groundY, -14 - rng.f(4)}
                Scale3: {s, s, s}

                trunk {
                    Position3: {0, 1.4, 0}
                    Box: {0.6, 2.8, 0.6}
                    Rgba: {104, 76, 48, 255}
                }

                canopy {
                    Position3: {0, 3.9, 0}
                    Sphere: {segments: 16, smooth: true, radius: 2.1}
                    Rgba: {56, 124, 58, 255}
                }
            }
        }
    }
}

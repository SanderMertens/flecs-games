module lettuce_pray.assets
using flecs.engine.*

fx {
    Particles: {
        capacity: 512,
        gravity: 8,
        drag: 2.4,
        alpha_envelope: {
            mode: ParticleEnvelopeEaseOut,
            fade_in: 0.05,
            fade_out: 0.5
        }
    }
}

glow {
    Particles: {
        capacity: 512,
        gravity: 2,
        drag: 1.5,
        emissive: 2.5,
        alpha_envelope: {
            mode: ParticleEnvelopeEaseOut,
            fade_in: 0.05,
            fade_out: 0.45
        }
    }
}


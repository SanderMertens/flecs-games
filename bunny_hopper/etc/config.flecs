// Engine configuration

using flecs.engine
using flecs.engine.*
using flecs.script

surface {
    Surface: {
        title: "Bunny Hopper"
        width: 1280
        height: 1024
        vsync: true
    }
}

camera {
    Camera: {
        fov: math.PI / 3,
        near_: 0.5,
        far_: 1000
    }
    Position3: {0, 5, 16}
    LookAt: {0, 2.8, 0}
}

sky {
    sun {
        Position3: {0.6, 2.2, 1.4}
        DirectionalLight: {intensity: 2}
        CelestialLight: {
            toa_intensity: 6,
            toa_color: {255, 255, 255, 255}
        }
        LookAt: {0, 0, 0}
        Rgba: {255, 255, 255, 255}
    }

    moon {
        Position3: {-1, 2, -1}
        DirectionalLight: {intensity: 0}
        CelestialLight: {
            toa_intensity: 0.0005,
            toa_color: {255, 255, 255, 255}
        }
        LookAt: {0, 0, 0}
        Rgba: {255, 255, 255, 255}
    }

    stars {
        Stars: {
            density: 0.9,
            cells: 180,
            size: 150,
            color_variation: 1
        }
        CelestialLight: {
            toa_intensity: 0.015,
            toa_color: {255, 255, 255, 255}
        }
        Rotation3: {0, 0, 0}
    }

    atmosphere {
        Atmosphere: {
            sun: sun,
            moon: moon,
            stars: stars
        }
    }
}

view {
    geometry { GeometryBatch }
    skybox { SkyBoxBatch }

    ssao {
        SSAO: { radius: 0.5 }
    }

    bloom {
        Bloom: {}
    }

    autoExposure {
        AutoExposure: {
            min_log_luma: -16,
            low_percentile: 0,
            min_brightness: 0.05,
            max_brightness: 0.55
        }
    }

    tonyMcMapFace {
        Tony: { auto_exposure: autoExposure }
    }

    RenderView: {
        camera: camera,
        atmosphere: sky.atmosphere,
        ambient_intensity: 0.5,
        screen_px_threshold: 3,
        shadow: {
            enabled: true,
            map_size: 4096,
            max_range: 200,
            bias: 0.0001
        },
        effects: [
            { enabled: true, effect: ssao },
            { enabled: true, effect: bloom },
            { enabled: true, effect: autoExposure },
            { enabled: true, effect: tonyMcMapFace }
        ]
    }

    RenderBatchSet: {
        batches: [ geometry, skybox ]
    }
}

ground {
    Position3: {0, -0.5, -10}
    Rgba: {100, 170, 85}
    Box: {200, 1, 90}
}

track {
    Position3: {0, -0.48, 0}
    Rgba: {185, 155, 105}
    Box: {200, 1, 3.2}
}

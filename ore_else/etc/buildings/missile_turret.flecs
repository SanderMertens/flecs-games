    head {
        Position3: {0, 1.16, -0.18}
        Rotation3: {0, 0, 0}

        rack {
            SurfaceWear: {dust: 0.65, grime: 0.3}
            Position3: {0, 0, 0}
            Box: {0.96, 0.26, 0.82}
            Rgba: steel
            PbrMaterial: {metallic: 0.6, roughness: 0.4}
        }

        pod_l {
            SurfaceWear: {dust: 0.6, grime: 0.3}
            Position3: {-0.3, 0.28, 0.1}
            Rotation3: {-0.5, 0, 0}
            Box: {0.34, 0.36, 1.04}
            Rgba: steelShade
            PbrMaterial: {metallic: 0.55, roughness: 0.42}

            rail {
                SurfaceWear: {dust: 0.55, grime: 0.3}
                Position3: {0, -0.22, 0}

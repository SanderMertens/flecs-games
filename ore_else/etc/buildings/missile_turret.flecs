            }

            tip_low {
                Position3: {0, -0.09, 0.62}
                Cone: {segments: 10, smooth: true, length: 0.3}
                Rotation3: {1.5708, 0, 0}
                Scale3: {0.15, 1, 0.15}
                Rgba: missileRed
            }
        }

        pod_r {
            SurfaceWear: {dust: 0.6, grime: 0.3}
            Position3: {0.3, 0.28, 0.1}
            Rotation3: {-0.5, 0, 0}
            Box: {0.34, 0.36, 1.04}
            Rgba: steelShade
            PbrMaterial: {metallic: 0.55, roughness: 0.42}

            rail {
                SurfaceWear: {dust: 0.55, grime: 0.3}
                Position3: {0, -0.22, 0}
                Box: {0.2, 0.12, 0.9}

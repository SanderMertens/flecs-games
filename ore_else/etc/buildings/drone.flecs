// Repair drone

module ore_else.assets

using flecs.script
using flecs.engine.*
using ore_else
using ore_else.resources

const droneSteel: Rgba = {172, 180, 194, 255}
const droneShade: Rgba = {112, 120, 136, 255}
const droneDeep: Rgba = {56, 62, 76, 255}
const droneHazard: Rgba = {240, 176, 58, 255}
const droneAccent: Rgba = {92, 236, 222, 255}
const droneWeld: Rgba = {120, 216, 255, 255}

prefab RotorBlade {
    Box: {0.42, 0.015, 0.05}
    Rgba: droneDeep
    PbrMaterial: {metallic: 0.6, roughness: 0.4}
}

@tree Parent
prefab RepairDrone {
    Speed: {value: 7}
    RepairRate: {value: 14, per_iron: 10}
    Flight: {cruise: 2.8, arrive: 0.45, ease: 1.8, bob: 0.07, bob_rate: 3.2, turn: 7, rotor: 34, spin_up: 2.5}

    hull {

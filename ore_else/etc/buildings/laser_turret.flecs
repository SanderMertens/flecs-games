                color: lampLive, dead: lampDead, status: true,
                w: 0.3, d: 0.1, h: 0.05, strength: 2.8
            }
        }
    }

    head {
        Position3: {0, 1.68, 0.04}
        Rotation3: {0, 0, 0}

        yoke_l {
            SurfaceWear: {dust: 0.6, grime: 0.3}

// Laser turret

module ore_else.assets

using flecs.script
using flecs.engine.*
using ore_else
using ore_else.resources

const steel: Rgba = {172, 180, 194, 255}
const steelShade: Rgba = {112, 120, 136, 255}
const steelDeep: Rgba = {56, 62, 76, 255}
const hazard: Rgba = {240, 176, 58, 255}
const laserPink: Rgba = {238, 96, 168, 255}
const lampLive: Rgba = {92, 236, 222, 255}
const lampDead: Rgba = {248, 84, 72, 255}

@detail "High efficiency photon delivery for melting opponents."
@tree Parent
@name "Laser turret"
prefab LaserTurret {
    Icon: {texture: icons.laser_turret}
    Recipe: {inputs: [IronPlate: 30, Wire: 10, Electronics: 10], craft_time: 4}
    Health: {value: 150, max: 150}
    PowerConsumer: {watts: 25}
    PowerCategory: {kind: Weapons}
    Turret: {}
    Damage: {value: 50}
    Range: {value: 13}
    Muzzle: {height: 1.7, forward: 0.74}
    Beam: {prefab: LaserBeam}

    hit_fx {
        Position3: {0, 0, 0}
        BeamSparks: {color: laserPink}
    }

    base {
        SurfaceWear: {dust: 0.15, grime: 0.95}
        Position3: {0, 0.13, 0}
        Box: {1.74, 0.26, 1.74}
        Rgba: steelDeep
        PbrMaterial: {metallic: 0.35, roughness: 0.6}
    }

    apron {

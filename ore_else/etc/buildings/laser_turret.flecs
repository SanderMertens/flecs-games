        SurfaceWear: {dust: 0.55, grime: 0.55}
        Position3: {0.54, 0.52, -0.56}
        Cylinder: {segments: 10, smooth: true, length: 0.42}
        Scale3: {0.12, 1, 0.12}
        Rgba: steelShade

        glow {
            Position3: {0, 0.06, 0}
            Cylinder: {segments: 10, smooth: true, length: 0.12}
            Scale3: {1.24, 1, 1.24}
            Rgba: laserPink
            Emissive: {strength: 2.6, color: laserPink}
        }
    }

    column {
        SurfaceWear: {dust: 0.6, grime: 0.65}

// Gun turret

module ore_else.assets

using flecs.script
using flecs.engine.*
using ore_else
using ore_else.resources

const steel: Rgba = {172, 180, 194, 255}
const steelShade: Rgba = {112, 120, 136, 255}
const steelDeep: Rgba = {56, 62, 76, 255}
const hazard: Rgba = {240, 176, 58, 255}
const accent: Rgba = {92, 236, 222, 255}
const lampDead: Rgba = {248, 84, 72, 255}
const gunSteel: Rgba = {84, 92, 108, 255}

@detail "Short range rapid fire."
@tree Parent
@name "Gun turret"
prefab GunTurret {
    Icon: {texture: icons.gun_turret}
    Recipe: {inputs: [IronPlate: 10, Wire: 15, Electronics: 5], craft_time: 2}
    Health: {value: 120, max: 120}
    PowerCategory: {kind: Weapons}
    Turret: {}
    Damage: {value: 2.5}
    Range: {value: 10}
    AttackInterval: {value: 0.12}
    Muzzle: {speed: 34, height: 1.7, forward: 1.06}
    Ammo: {projectile: Tracer}

    base {
        SurfaceWear: {dust: 0.15, grime: 0.95}
        Position3: {0, 0.13, 0}
        Box: {1.74, 0.26, 1.74}
        Rgba: steelDeep
        PbrMaterial: {metallic: 0.35, roughness: 0.6}
    }

    apron {
        SurfaceWear: {dust: 0.4, grime: 0.8}
        Position3: {0, 0.28, 0}
        Box: {1.44, 0.08, 1.44}
        Rgba: steelShade
        PbrMaterial: {metallic: 0.45, roughness: 0.5}
    }

    lip : HazardTrim {

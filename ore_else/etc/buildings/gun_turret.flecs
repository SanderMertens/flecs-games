            SurfaceWear: {dust: 0.7, grime: 0.3}
            Position3: {0, 0.16, -0.08}
            Box: {0.82, 0.48, 0.72}
            Rgba: steel
            PbrMaterial: {metallic: 0.6, roughness: 0.38}

// Shared animation curves for particle pools

module ore_else.assets

using flecs.engine.*
using ore_else

curvePuff {
    BezierCurve: {y0: 0.45, x1: 0.2, y1: 1.3, x2: 0.6, y2: 1.4, y3: 1.5}
}

curveSwell {
    BezierCurve: {y0: 0.35, x1: 0.25, y1: 1.35, x2: 0.7, y2: 1.85, y3: 2.1}
}

curveFlare {
    BezierCurve: {y0: 0.3, x1: 0.12, y1: 1.8, x2: 0.5, y2: 1.5, y3: 0.95}
}

curveShock {
    BezierCurve: {y0: 0.15, x1: 0.08, y1: 2.0, x2: 0.3, y2: 2.3, y3: 2.4}
}

curveTaper {
    BezierCurve: {y0: 1.25, x1: 0.35, y1: 0.95, x2: 0.7, y2: 0.4, y3: 0.05}
}

curveSpike {
    BezierCurve: {y0: 0.9, x1: 0.1, y1: 1.15, x2: 0.35, y2: 0.2, y3: 0}
}

curveSmokeFade {
    BezierCurve: {y0: 0, x1: 0.15, y1: 1.2, x2: 0.6, y2: 0.95, y3: 0}
}

curveEmberFade {
    BezierCurve: {y0: 0.15, x1: 0.2, y1: 1.15, x2: 0.65, y2: 0.85, y3: 0}
}

// Bullet tracer

module ore_else.assets

using flecs.script
using flecs.engine.*
using ore_else

const tracerGold: Rgba = {255, 226, 128, 255}

@tree Parent
prefab Tracer {
    Projectile: {radius: 0.55, life: 0.7, gravity: 0}

    core {
        Position3: {0, 0, 0}
        Box: {0.08, 0.08, 0.42}
        Rgba: tracerGold
        Emissive: {strength: 3.2, color: tracerGold}
        PointLight: {intensity: 2.6, range: 4.5}
    }
}

// Rocket

module ore_else.assets

using flecs.script
using flecs.engine.*
using ore_else

const rocketHull: Rgba = {228, 232, 240, 255}
const rocketShade: Rgba = {150, 158, 174, 255}
const rocketDark: Rgba = {48, 54, 68, 255}
const rocketSoot: Rgba = {32, 34, 42, 255}
const rocketTrim: Rgba = {238, 138, 52, 255}
const rocketGlass: Rgba = {126, 214, 240, 255}
const rkSkirtH: f32 = 0.62
const rkTankH: f32 = 1.02
const rkBayH: f32 = 0.78
const rkCapsuleH: f32 = 1.04
const rkRadius: f32 = 0.42

@tree Parent
template Rocket {
    prop engines: i32 = 0
    prop fuel: i32 = 0
    prop cargo: i32 = 0
    prop life_support: i32 = 0
    prop loaded: bool = false
    prop valid: bool = false

    const engineY: f32 = match engines > 0 {
        true: rkSkirtH
        false: 0
    }

    const tankY: f32 = engineY + fuel * rkTankH
    const bayY: f32 = tankY + cargo * rkBayH
    const noseY: f32 = bayY + life_support * rkCapsuleH

    const bellMid: f32 = match engines > 4 {
        true: 0.72
        false: 1
    }

    const bellScale: f32 = match engines > 8 {
        true: 0.56
        false: bellMid
    }

    const bellRing: f32 = match engines > 4 {
        true: 0.32
        false: 0.22
    }

    const bellInner: i32 = match engines > 6 {
        true: engines / 3
        false: 0
    }

    const bellOuter: i32 = engines - bellInner

    const finCount: i32 = match engines > 0 {
        true: 4
        false: 0
    }

    if engines > 0 {
        thrust_plate {
            Position3: {0, 0.19, 0}
            Cylinder: {segments: 20, smooth: true, length: 0.08}
            Scale3: {(rkRadius - 0.04) * 2, 1, (rkRadius - 0.04) * 2}
            Rgba: rocketSoot
            PbrMaterial: {metallic: 0.75, roughness: 0.45}
        }

        skirt_flare {
            Position3: {0, 0.26, 0}
            Cylinder: {segments: 20, smooth: true, length: 0.12}
            Scale3: {(rkRadius + 0.05) * 2, 1, (rkRadius + 0.05) * 2}
            Rgba: rocketSoot
            PbrMaterial: {metallic: 0.7, roughness: 0.5}
        }

        skirt {
            Position3: {0, 0.44, 0}
            Cylinder: {segments: 20, smooth: true, length: 0.36}
            Scale3: {rkRadius * 2, 1, rkRadius * 2}
            Rgba: rocketDark
            PbrMaterial: {metallic: 0.86, roughness: 0.28}
        }

        skirt_collar {
            Position3: {0, 0.605, 0}
            Cylinder: {segments: 20, smooth: true, length: 0.07}
            Scale3: {(rkRadius + 0.02) * 2, 1, (rkRadius + 0.02) * 2}
            Rgba: rocketTrim
        }
    }

    for i in 0..bellInner {
        const a = 6.2832 * i / bellInner

        "bell_in_{i}" {
            Position3: {math.cos(a) * 0.13, 0, math.sin(a) * 0.13}
            Rotation3: {0, a, 0}
            RocketBell: {scale: bellScale}
        }
    }

    for i in 0..bellOuter {
        const a = 6.2832 * i / bellOuter + 0.4

        "bell_out_{i}" {
            Position3: {
                math.cos(a) * bellRing, 0, math.sin(a) * bellRing
            }
            Rotation3: {0, a, 0}
            RocketBell: {scale: bellScale}
        }
    }

    for i in 0..finCount {
        const a = 1.5708 * i + 0.7854

        "fin_{i}" {
            Position3: {
                math.cos(a) * (rkRadius + 0.02), 0.4,
                math.sin(a) * (rkRadius + 0.02)
            }
            Rotation3: {0, 0 - a, 0}
            Box: {0.2, 0.56, 0.4}
            Rgba: rocketTrim
            PbrMaterial: {metallic: 0.6, roughness: 0.42}
        }
    }

    for i in 0..fuel {
        const y = engineY + i * rkTankH

        "tank_{i}" {
            Position3: {0, y + rkTankH * 0.5, 0}
            Cylinder: {segments: 20, smooth: true, length: rkTankH - 0.03}
            Scale3: {rkRadius * 2, 1, rkRadius * 2}
            Rgba: rocketHull
            PbrMaterial: {metallic: 0.72, roughness: 0.3}
        }

        "tank_collar_{i}" {
            Position3: {0, y + 0.04, 0}
            Cylinder: {segments: 20, smooth: true, length: 0.08}
            Scale3: {(rkRadius + 0.03) * 2, 1, (rkRadius + 0.03) * 2}
            Rgba: rocketShade
            PbrMaterial: {metallic: 0.8, roughness: 0.26}
        }

        "tank_stripe_{i}" {
            Position3: {0, y + rkTankH * 0.5, rkRadius + 0.01}
            Box: {0.18, rkTankH * 0.58, 0.06}
            Rgba: rocketTrim
        }

        "tank_duct_{i}" {
            Position3: {
                0 - (rkRadius - 0.03), y + rkTankH * 0.5, -0.15
            }
            Box: {0.11, rkTankH * 0.8, 0.11}
            Rgba: rocketShade
            PbrMaterial: {metallic: 0.8, roughness: 0.3}
        }

        "tank_clip_{i}" {
            Position3: {
                0 - (rkRadius - 0.1), y + rkTankH * 0.5, -0.15
            }
            Box: {0.16, 0.1, 0.16}
            Rgba: rocketDark
        }
    }

    for i in 0..cargo {
        const y = tankY + i * rkBayH

        "bay_{i}" {
            Position3: {0, y + rkBayH * 0.5, 0}
            Rotation3: {0, 0.5 * i, 0}
            RocketBay: {lit: loaded}
        }
    }

    if life_support > 0 {
        capsule_collar {
            Position3: {0, bayY + 0.05, 0}
            Cylinder: {segments: 20, smooth: true, length: 0.1}
            Scale3: {(rkRadius + 0.03) * 2, 1, (rkRadius + 0.03) * 2}
            Rgba: rocketTrim
        }

        capsule {
            Position3: {0, bayY + 0.53, 0}
            Cylinder: {segments: 20, smooth: true, length: 0.86}
            Scale3: {(rkRadius - 0.02) * 2, 1, (rkRadius - 0.02) * 2}
            Rgba: rocketHull
            PbrMaterial: {metallic: 0.7, roughness: 0.28}
        }

        capsule_window {
            Position3: {0, bayY + 0.66, rkRadius - 0.05}
            Box: {0.3, 0.26, 0.06}
            Rgba: rocketGlass
            Emissive: {strength: 2.6, color: rocketGlass}
        }

        capsule_hatch {
            Position3: {0 - (rkRadius - 0.05), bayY + 0.48, 0}
            Box: {0.06, 0.34, 0.28}
            Rgba: rocketShade
            PbrMaterial: {metallic: 0.75, roughness: 0.3}
        }

        capsule_cap {
            Position3: {0, bayY + 1.0, 0}
            Cylinder: {segments: 20, smooth: true, length: 0.1}
            Scale3: {(rkRadius - 0.01) * 2, 1, (rkRadius - 0.01) * 2}
            Rgba: rocketShade
            PbrMaterial: {metallic: 0.75, roughness: 0.3}
        }
    }

    if valid {
        nose_base {
            Position3: {0, noseY + 0.06, 0}
            Cylinder: {segments: 20, smooth: true, length: 0.12}
            Scale3: {(rkRadius - 0.01) * 2, 1, (rkRadius - 0.01) * 2}
            Rgba: rocketShade
            PbrMaterial: {metallic: 0.78, roughness: 0.26}
        }

        nose_cone {
            Position3: {0, noseY + 0.57, 0}
            Cone: {segments: 20, smooth: true, length: 0.88}
            Scale3: {(rkRadius - 0.02) * 2, 1, (rkRadius - 0.02) * 2}
            Rgba: rocketHull
            PbrMaterial: {metallic: 0.74, roughness: 0.24}
        }

        nose_tip {
            Position3: {0, noseY + 1.06, 0}
            Sphere: {segments: 12, smooth: true, radius: 0.08}
            Rgba: rocketTrim
            Emissive: {strength: 2.4, color: rocketTrim}
        }
    }
}

// Cargo bay port light

module ore_else.assets

using flecs.script
using flecs.engine.*
using ore_else

const rocketDark: Rgba = {48, 54, 68, 255}
const cargoGlow: Rgba = {92, 236, 222, 255}

template RocketPort {
    prop lit: bool = false

    Box: {0.06, 0.24, 0.22}
    Rgba: match lit {
        true: cargoGlow
        false: rocketDark
    }

    if lit {
        Emissive: {strength: 2.6, color: cargoGlow}
    }
}

// Wall decor props

using flecs.script
using flecs.engine.*

decor_assets {
    prefab chart_tex {
        Texture: {"etc/assets/props/chart_down.svg", 1024, 768}
    }

    prefab board_tex {
        Texture: {"etc/assets/props/whiteboard.svg", 1024, 512}
    }

    prefab note_a_tex {
        Texture: {"etc/assets/props/postit_a.svg", 768, 768}
    }

    prefab note_b_tex {
        Texture: {"etc/assets/props/postit_b.svg", 768, 768}
    }

    prefab note_c_tex {
        Texture: {"etc/assets/props/postit_c.svg", 768, 768}
    }

    prefab note_d_tex {
        Texture: {"etc/assets/props/postit_d.svg", 768, 768}
    }

    prefab ChartBoard {
        Quad: {1.4, 1.05}
        PbrTextures: {albedo: chart_tex}
    }

    prefab WhiteBoardFace {
        Quad: {3.2, 1.6}
        PbrTextures: {albedo: board_tex}
    }

    prefab ChartPoster {
        frame {
            Position3: {0, 0, 0}
            Box: {1.52, 1.17, 0.03}
            Rgba: {88, 70, 52, 255}
        }

        board : ChartBoard {
            Position3: {0, 0, 0.03}
        }
    }

    prefab WhiteBoard {
        frame {
            Position3: {0, 0, 0}
            Box: {3.36, 1.76, 0.04}
            Rgba: {202, 206, 212, 255}
        }

        board : WhiteBoardFace {
            Position3: {0, 0, 0.035}
        }

        tray {
            Position3: {0, -0.91, 0.07}
            Box: {1.0, 0.05, 0.12}
            Rgba: {182, 188, 196, 255}
        }

        marker_red {
            Position3: {-0.22, -0.865, 0.08}
            Box: {0.16, 0.035, 0.035}
            Rgba: {200, 70, 60, 255}
        }

        marker_blue {
            Position3: {0.08, -0.865, 0.08}
            Box: {0.16, 0.035, 0.035}
            Rgba: {70, 110, 190, 255}
        }
    }

    prefab PostItA {
        Quad: {0.26, 0.26}
        PbrTextures: {albedo: note_a_tex}
    }

    prefab PostItB {
        Quad: {0.26, 0.26}
        PbrTextures: {albedo: note_b_tex}
    }

    prefab PostItC {
        Quad: {0.26, 0.26}
        PbrTextures: {albedo: note_c_tex}
    }

    prefab PostItD {
        Quad: {0.26, 0.26}
        PbrTextures: {albedo: note_d_tex}
    }
}

decor {
    chart_side : decor_assets.ChartPoster {
        Position3: {11.18, 1.85, -4.4}
        Rotation3: {0, -math.PI / 2, 0}
    }

    whiteboard : decor_assets.WhiteBoard {
        Position3: {-11.18, 1.7, -2.5}
        Rotation3: {0, math.PI / 2, 0}
    }

    note_1 : decor_assets.PostItA {
        Position3: {-2.25, 0.95, -7.08}
        Rotation3: {0, 0, 0.12}
    }

    note_2 : decor_assets.PostItB {
        Position3: {-1.92, 0.68, -7.08}

module cfg.effects

using flecs.engine.*

build_pool {
  Particles: {
    capacity: 4096
    gravity: 0.3
    drag: 4
    emissive: 0
    size_envelope: {mode: ParticleEnvelopeEaseOut, fade_out: 0.1}
    alpha_envelope: {mode: ParticleEnvelopeEaseInOut, fade_in: 0.05, fade_out: 0.35}
  }
}

prefab build_burst {
  ParticleBurst: {
    pool: build_pool
    count: 25
    size: 0.5
    size_variance: 0.6
    grow: 0.5
    max_age: 1
    max_age_variance: 0.25
    color: {155, 130, 100, 200}
    velocity: {0, 1.5, 0}
    velocity_variance: {12, 2, 12}
    offset: {0, 0.6, 0}
    radial: 9
  }
}

